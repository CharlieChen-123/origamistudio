            "text": "Lift this flap",
            "start": 0,
            "end": 0.8
          }
        ],
        "cues": [
          {
            "at": 0.5,
            "text": "The flap is halfway up. Check the fixed hinge, then continue.",
            "pause": true,
            "focus": {
              "anchor": {
                "uv": [
                  130,
                  200
                ]
              },
              "zoom": 1.6
            }
          }
        ]
      }
    },
    {
      "kind": "unfold",
      "foldIndex": 0,
      "title": "Open the paper",
